# Gnuboard5 Playwright Test Configuration
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요.
# cp .env.example .env

# 기본 사이트 URL (필수)
# 테스트할 그누보드5 사이트의 기본 URL을 입력하세요.
# 예: https://example.com 또는 http://localhost:8080
BASE_URL=https://your-gnuboard-site.com

# 테스트 계정 정보 (필수)
# 테스트용 일반 사용자 계정 정보를 입력하세요.
USER_ID=your_test_account_id
USER_PW=your_test_account_password

# 관리자 계정 정보 (선택)
# 관리자 페이지 테스트가 필요한 경우 설정하세요.
# ADMIN_ID=admin
# ADMIN_PW=admin_password

# ⚠️ 보안 주의사항:
# - 이 파일(.env)을 절대 Git에 커밋하지 마세요!
# - .gitignore에 .env가 포함되어 있는지 확인하세요.
# - 실제 운영 환경의 계정 정보를 사용하지 마세요.
# - 테스트 전용 계정을 생성하여 사용하는 것을 권장합니다.
